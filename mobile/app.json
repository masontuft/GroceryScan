{
  "expo": {
    "name": "GroceryScan",
    "slug": "groceryscan",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.masontuft.groceryscan",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.masontuft.groceryscan",
      "adaptiveIcon": {
        "backgroundColor": "#05161E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan grocery barcodes."
        }
      ],
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-app.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2A383F"
        }
      ],
      "expo-localization",
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow $(PRODUCT_NAME) to access your Reminders lists so it can sync your grocery basket to a list you choose.",
          "remindersPermission": "Allow $(PRODUCT_NAME) to access your Reminders lists so it can sync your grocery basket to a list you choose."
        }
      ]
    ],
    "owner": "masson",
    "extra": {
      "eas": {
        "projectId": "3dfa4ab1-9846-4be6-9013-b64a650a29fd"
      }
    }
  }
}
